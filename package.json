{
  "name": "chip",
  "version": "2.0.0",
  "private": true,
  "description": "CHIP: local bridge for the BELLA design system. Local model, local search, terminal.",
  "type": "module",
  "bin": {
    "chip": "bin/chip.mjs"
  },
  "scripts": {
    "test": "node --test --test-force-exit server/test/*.test.mjs",
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "sync:bella": "node scripts/sync-bella.mjs",
    "sync:notion": "node scripts/sync-notion.mjs",
    "sync": "node bin/chip.mjs sync",
    "app": "vite --config app/vite.config.js",
    "app:build": "vite build --config app/vite.config.js",
    "checkpoint": "node scripts/checkpoint.mjs",
    "check:leaders": "node scripts/stage-leader-check.mjs",
    "check:drawer-inset": "node scripts/drawer-inset-check.mjs",
    "check:cards": "node scripts/card-align-check.mjs",
    "check:responsive": "node scripts/responsive-check.mjs",
    "check:scroll": "node scripts/scroll-chain-check.mjs",
    "check:stories": "node scripts/story-links-check.mjs",
    "check:states": "node scripts/states-strip-check.mjs",
    "check:topbar": "node scripts/top-bar-check.mjs",
    "check:process-lines": "node scripts/process-line-check.mjs",
    "review": "node scripts/second-review.mjs",
    "storybook": "storybook dev -p 6122 --no-open"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@notionhq/client": "^5.27.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.6",
    "@vitejs/plugin-react": "^6.1.1",
    "storybook": "10.6.6",
    "vite": "^8.1.5"
  }
}
